{
  "expo": {
    "name": "AS Operadora",
    "slug": "as-operadora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "asoperadora",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.asoperadora.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Usamos Face ID para que puedas iniciar sesión de forma rápida y segura.",
        "NSLocationWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte hoteles, actividades y servicios cercanos.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Necesitamos tu ubicación para mostrarte hoteles, actividades y servicios cercanos.",
        "NSCameraUsageDescription": "Necesitamos acceso a la cámara para tomar fotos de perfil y documentos de viaje.",
        "NSPhotoLibraryUsageDescription": "Necesitamos acceso a tus fotos para subir documentos y comprobantes de viaje."
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC-eV8KIUZCyX0uvXUs4V2biXct-7h8SsY"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.asoperadora.app",
      "permissions": [
        "NOTIFICATIONS",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyC-eV8KIUZCyX0uvXUs4V2biXct-7h8SsY"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permitir que AS Operadora use tu ubicación para mostrarte servicios cercanos y trazar rutas."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.asoperadora.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}